{
	"version": 1,
	"base_image": "codeocean/jupyterlab:3.6.1-miniconda4.12.0-python3.9-ubuntu20.04",
	"args": [
		"AWS_ACCESS_KEY_ID",
		"AWS_DEFAULT_REGION",
		"AWS_SECRET_ACCESS_KEY",
		"CUSTOM_KEY"
	],
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true
	},
	"installers": {
		"pip": {
			"packages": [
				{
					"name": "codeocean",
					"version": "0.3.0"
				},
				{
					"name": "dask",
					"version": "2023.7.1"
				},
				{
					"name": "hdf5plugin",
					"version": "5.1.0"
				},
				{
					"name": "kerchunk",
					"version": "0.2.7"
				},
				{
					"name": "matplotlib",
					"version": "3.9.2"
				},
				{
					"name": "numpy",
					"version": "1.24.4"
				},
				{
					"name": "pyyaml",
					"version": "6.0.1"
				},
				{
					"name": "s3fs",
					"version": "2025.7.0"
				},
				{
					"name": "scikit-image",
					"version": "0.21.0"
				},
				{
					"name": "seaborn",
					"version": "0.13.2"
				},
				{
					"name": "tifffile",
					"version": "2023.7.10"
				},
				{
					"name": "xmltodict",
					"version": "0.14.2"
				},
				{
					"name": "zarr",
					"version": "2.16.0"
				}
			],
			"options": {},
			"pre_install_options": {}
		},
		"vscode": {
			"packages": [
				{
					"name": "continue.continue"
				},
				{
					"name": "ms-python.python"
				},
				{
					"name": "ms-toolsai.jupyter"
				},
				{
					"name": "reageyao.biosyntax"
				},
				{
					"name": "reditorsupport.r"
				},
				{
					"name": "saoudrizwan.claude-dev"
				}
			],
			"version": "4.100.3"
		}
	}
}